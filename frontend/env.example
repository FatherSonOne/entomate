# Frontend Environment Variables
# Copy this file to .env.local or .env and fill in your values

# ========================================
# Clerk Authentication
# ========================================
# Get your publishable key from: https://dashboard.clerk.com
# This key is safe to expose in frontend code
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ========================================
# API Configuration
# ========================================
# Backend API URL (leave empty to use Vite proxy, or set full URL)
# For development: leave empty or use http://localhost:3000
# For production: set to your backend URL (e.g., https://api.yourapp.com)
VITE_API_URL=

