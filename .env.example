# Entomate Environment Configuration
# Copy this file to .env and fill in your values

# ==================== REQUIRED ====================

# Gemini AI API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Primary Database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==================== LOGOS VISION CRM INTEGRATION ====================
# Connect directly to Logos Vision's Supabase for bidirectional sync
# This enables:
# - Action items from meetings → Logos Vision tasks
# - Meetings → Logos Vision activities
# - Projects ↔ Projects linking

# Logos Vision Supabase Connection (REQUIRED for CRM sync)
VITE_LOGOS_VISION_SUPABASE_URL=https://your-logos-vision-project.supabase.co
VITE_LOGOS_VISION_SUPABASE_ANON_KEY=your_logos_vision_anon_key_here

# Alternative: REST API approach (legacy, not recommended)
# LOGOS_VISION_BASE_URL=https://api.logosvision.com
# LOGOS_VISION_API_KEY=your_logos_vision_api_key_here

# ==================== PULSE CHAT INTEGRATION ====================

# Pulse Chat API (for messaging integration)
PULSE_BASE_URL=https://api.pulse.com
PULSE_API_KEY=your_pulse_api_key_here

# ==================== PHASE 2 - SECURITY ====================

# Admin API Key (protects dangerous endpoints like agent enable/disable)
ADMIN_API_KEY=change-me-to-a-long-random-string

# ==================== OPTIONAL ====================

# Pulse Chat Integration (if using separate Supabase instance)
# PULSE_SUPABASE_URL=https://your-pulse-project.supabase.co
# PULSE_SUPABASE_KEY=your_pulse_supabase_key_here

# Redis URL (optional - for BullMQ job queue)
# REDIS_URL=redis://localhost:6379

# Environment (development | staging | production)
NODE_ENV=development
