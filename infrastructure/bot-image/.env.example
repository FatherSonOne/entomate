# Bot image local-test env (NEVER commit a real .env).
# Copy to .env and fill in real values for `docker run --env-file .env`.
# This file is read ONLY for local Docker testing — Fly Machines get these
# values injected by the orchestrator at launch.

# ---- Per-session (any plausible values for local testing) ----
BOT_SESSION_ID=test-local-001
BOT_WORKSPACE_ID=test-workspace
BOT_MEETING_ID=test-meeting
BOT_MEETING_URL=https://meet.google.com/agj-onej-fao
BOT_PLATFORM=meet
BOT_MAX_DURATION_MS=300000
BOT_CALLBACK_URL=
BOT_CALLBACK_TOKEN=

# ---- Runtime ----
BOT_HEADLESS=true
BOT_AUDIO_DIR=/tmp/bot-audio

# ---- Meet Mate identity (from your password manager) ----
MEET_MATE_EMAIL=
MEET_MATE_PASSWORD=
MEET_MATE_TOTP_SECRET=
MEET_MATE_DISPLAY_NAME=Meet Mate
