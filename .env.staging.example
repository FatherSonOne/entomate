# ========================================
# Entomate Staging Environment
# Week 8: Production Deployment
# ========================================
# For testing before production deployment

# ========================================
# Server Configuration
# ========================================
NODE_ENV=staging
PORT=3000
TRUST_PROXY=1

# ========================================
# URLs
# ========================================
FRONTEND_URL=https://staging.yourdomain.com
CORS_ORIGINS=https://staging.yourdomain.com

# ========================================
# Database (Supabase - Staging Project)
# ========================================
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_KEY=your-staging-service-key

# ========================================
# AI Configuration
# ========================================
OPENAI_API_KEY=sk-your-openai-key
# or
GEMINI_API_KEY=your-gemini-key

# ========================================
# CRM Integration (Sandbox/Dev account)
# ========================================
CRM_PROVIDER=hubspot
CRM_API_KEY=your-staging-hubspot-api-key

# ========================================
# Chat Integration (Test workspace)
# ========================================
CHAT_PROVIDER=slack
SLACK_BOT_TOKEN=xoxb-your-staging-slack-token
SLACK_DEFAULT_CHANNEL=staging-tests

# ========================================
# Session & Security
# ========================================
SESSION_SECRET=staging-session-secret-value
JWT_SECRET=staging-jwt-secret-value

# ========================================
# Error Tracking (Sentry - Staging)
# ========================================
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0

# ========================================
# Logging (more verbose for staging)
# ========================================
LOG_LEVEL=debug
LOGS_DIR=/app/logs
