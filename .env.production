# ========================================
# Entomate Production Environment
# Week 8: Production Deployment
# ========================================
# IMPORTANT: Copy this file and fill in real values
# Never commit actual secrets to version control!

# ========================================
# Server Configuration
# ========================================
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# ========================================
# URLs
# ========================================
FRONTEND_URL=https://app.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ========================================
# Database (Supabase)
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ========================================
# AI Configuration
# ========================================
# Option 1: OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Option 2: Google Gemini
GEMINI_API_KEY=your-gemini-key

# ========================================
# CRM Integration
# ========================================
CRM_PROVIDER=hubspot
CRM_API_KEY=your-hubspot-api-key
# CRM_PROVIDER=pipedrive
# CRM_API_KEY=your-pipedrive-api-key

# ========================================
# Chat Integration
# ========================================
CHAT_PROVIDER=slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=general
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ========================================
# Calendar Integration (Google)
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/calendar/callback

# ========================================
# Email (SendGrid)
# ========================================
SENDGRID_API_KEY=SG.your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ========================================
# Session & Security
# ========================================
SESSION_SECRET=generate-a-long-random-string-here
JWT_SECRET=generate-another-long-random-string

# ========================================
# Error Tracking (Sentry)
# ========================================
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# Logging
# ========================================
LOG_LEVEL=info
LOGS_DIR=/app/logs

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
