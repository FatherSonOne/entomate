# ========================================
# ENTOMATE BACKEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5175
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Internal API key for service-to-service calls (optional)
INTERNAL_API_KEY=

# ========================================
# AI PROVIDER SELECTION
# ========================================
# Set to 'gemini' or 'openai'
AI_PROVIDER=gemini

# ========================================
# GOOGLE GEMINI AI API
# ========================================
# Get your API key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# SUPABASE CONFIGURATION
# ========================================
# Get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ========================================
# CRM INTEGRATION
# ========================================
# Choose your CRM provider: hubspot, salesforce, or pipedrive
CRM_PROVIDER=hubspot

# HubSpot Configuration
# Get API key from: Settings > Private Apps > Create
CRM_API_KEY=your_hubspot_private_app_token

# Salesforce Configuration (if using Salesforce)
# SALESFORCE_INSTANCE_URL=https://yourinstance.salesforce.com
# CRM_API_KEY=your_salesforce_access_token

# Pipedrive Configuration (if using Pipedrive)
# CRM_API_KEY=your_pipedrive_api_token

# ========================================
# CHAT INTEGRATION
# ========================================
# Choose your chat provider: slack, teams, or discord
CHAT_PROVIDER=slack

# Slack Configuration
# Create app at: https://api.slack.com/apps
# Add scopes: chat:write, channels:read, users:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=general

# Microsoft Teams Configuration (if using Teams)
# Create incoming webhook in Teams channel settings
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Discord Configuration (if using Discord)
# Create webhook in Discord channel settings
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ========================================
# OPTIONAL: EMAIL INTEGRATION
# ========================================
# For sending email notifications (Phase 2)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password
# SMTP_FROM=noreply@entomate.com

# ========================================
# OPTIONAL: ADVANCED SETTINGS
# ========================================
# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# AI processing rate limit
AI_RATE_LIMIT_MAX=10

# Log level: debug, info, warn, error
LOG_LEVEL=info
