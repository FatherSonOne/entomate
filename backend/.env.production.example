# ========================================
# ENTOMATE PRODUCTION ENVIRONMENT
# ========================================
# Copy to .env.production and fill in your values
# NEVER commit this file with real values!

# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.yourdomain.com

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-256-bit-secret-here

# Internal API key for service-to-service calls
INTERNAL_API_KEY=your-internal-api-key

# ========================================
# GOOGLE GEMINI AI API
# ========================================
GEMINI_API_KEY=your-production-gemini-api-key

# ========================================
# SUPABASE CONFIGURATION
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_KEY=your-production-service-key

# ========================================
# CRM INTEGRATION
# ========================================
CRM_PROVIDER=hubspot
CRM_API_KEY=your-production-crm-api-key

# ========================================
# CHAT INTEGRATION
# ========================================
CHAT_PROVIDER=slack
SLACK_BOT_TOKEN=xoxb-your-production-bot-token
SLACK_DEFAULT_CHANNEL=general

# ========================================
# ERROR TRACKING (SENTRY)
# ========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20

# ========================================
# SECURITY
# ========================================
# Trusted proxy count (for load balancers)
TRUST_PROXY=1

# CORS origins (comma-separated)
CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# ========================================
# REDIS (OPTIONAL - FOR CACHING)
# ========================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ========================================
# SMTP EMAIL (OPTIONAL)
# ========================================
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=noreply@yourdomain.com
