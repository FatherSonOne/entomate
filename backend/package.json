{
  "name": "entomate-backend",
  "version": "1.0.0",
  "description": "Entomate Meeting & Project AI Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:api": "node ../tests/api-contract-validation.test.js",
    "test:api:full": "TEST_AUTH_TOKEN=$CLERK_TEST_TOKEN node ../tests/api-contract-validation.test.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "security:audit": "npm audit --audit-level=moderate",
    "build:docker": "docker build -t entomate-backend ."
  },
  "dependencies": {
    "@anthropic-studio/shared-hub": "file:../../shared-hub",
    "@google/generative-ai": "^0.21.0",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.47.0",
    "axios": "^1.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.2",
    "googleapis": "^169.0.0",
    "helmet": "^8.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "openai": "^6.14.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "uuid": "^11.0.0",
    "winston": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^2.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
