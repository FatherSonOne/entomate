# Backend Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# Server Configuration
# ========================================
# Port for the backend server
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173

# CORS allowed origins (comma-separated, optional - defaults to FRONTEND_URL)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Trust proxy setting (for load balancers, set to 1 in production)
# TRUST_PROXY=1

# ========================================
# Clerk Authentication
# ========================================
# Get your secret key from: https://dashboard.clerk.com
# ⚠️ NEVER commit this key to version control!
# This key is used to verify JWT tokens from Clerk
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ========================================
# Session Configuration
# ========================================
# Secret for session cookies (generate a random string)
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here_change_this_in_production

# ========================================
# Database Configuration (Supabase)
# ========================================
# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public key)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service key (admin key - keep secret!)
# ⚠️ NEVER commit this key to version control!
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ========================================
# Internal API Key (Optional)
# ========================================
# For service-to-service communication
# INTERNAL_API_KEY=your_internal_api_key_here

# ========================================
# AI Service Keys (Optional)
# ========================================
# OpenAI API key
# OPENAI_API_KEY=sk-your_openai_key_here

# Google Gemini API key
# GEMINI_API_KEY=your_gemini_key_here

# ========================================
# Other Service Keys (Optional)
# ========================================
# Slack Bot Token
# SLACK_BOT_TOKEN=xoxb-your_slack_bot_token

# Slack Signing Secret
# SLACK_SIGNING_SECRET=your_slack_signing_secret

# Google OAuth (for Calendar integration)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback

