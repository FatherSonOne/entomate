{
  "name": "entomate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Entomate monorepo root — tooling only. The app lives in backend/ (Node/Express, Render) and frontend/ (React, Vercel), each with its own package.json.",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint backend --ext .js"
  },
  "lint-staged": {
    "frontend/src/**/*.{js,jsx}": [
      "npx eslint --fix --no-error-on-unmatched-pattern"
    ],
    "backend/**/*.js": [
      "npx eslint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
